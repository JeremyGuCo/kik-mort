rules_version = '2';

// ============================================================================
// Kik-Mort — Règles Firestore (équivalent des policies RLS Supabase)
//
// Modèle de données :
//   users/{uid}                        { username, avatarUrl, totalScore, createdAt }
//   declarations/{declarationId}       { celebrityName, declaredBy, status, scoreAwarded, createdAt, closedAt }
//   declarations/{id}/votes/{voterId}  { known, emotion, createdAt, updatedAt }
//     (l'id du document de vote = uid du votant : empêche nativement un
//      deuxième vote du même joueur sur la même déclaration, sans requête).
//   meta/registrationCount             { count }
//     (compteur d'inscriptions, incrémenté atomiquement à chaque nouveau
//      profil créé — voir la fonction underCap() ci-dessous).
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Un compte Auth peut exister sans profil : c'est le cas d'un compte
    // créé au-delà du quota d'inscriptions (voir meta/registrationCount),
    // volontairement laissé orphelin. Ce garde-fou l'empêche d'écrire quoi
    // que ce soit dans l'app.
    function hasProfile() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function declaration(declarationId) {
      return get(/databases/$(database)/documents/declarations/$(declarationId)).data;
    }

    // Groupe d'amis fermé pour l'instant : au-delà de 5 inscriptions, plus
    // personne ne peut créer de profil (la connexion des comptes existants
    // reste possible, eux ont déjà un profil). Le compteur peut ne pas
    // encore exister (avant la toute première inscription) : dans ce cas
    // on le considère à 0.
    function underCap() {
      return !exists(/databases/$(database)/documents/meta/registrationCount)
        || get(/databases/$(database)/documents/meta/registrationCount).data.count < 5;
    }

    // ------------------------------------------------------------------
    // meta/registrationCount — compteur d'inscriptions
    // ------------------------------------------------------------------
    match /meta/registrationCount {
      allow read: if isSignedIn();

      // Première inscription jamais faite : le document n'existe pas encore.
      allow create: if isSignedIn() && request.resource.data.count == 1;

      // Incrément strict de 1, et seulement si le quota n'était pas déjà
      // atteint — bloque toute tentative de dépasser 5, même en contournant
      // le client.
      allow update: if isSignedIn()
        && request.resource.data.count == resource.data.count + 1
        && resource.data.count < 5;
    }

    // ------------------------------------------------------------------
    // users
    // ------------------------------------------------------------------
    match /users/{userId} {
      // Classement public : tout joueur connecté voit tous les profils.
      allow read: if isSignedIn();

      // Le profil est créé côté client à la première connexion, en même
      // temps (même transaction) que l'incrément de meta/registrationCount
      // — les deux écritures doivent passer ensemble ou pas du tout.
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.totalScore == 0
        && underCap();

      // Un joueur peut modifier son propre profil (username, avatar) mais
      // ne peut jamais toucher à totalScore : seule la Cloud Function
      // closeDeclaration (Admin SDK, hors règles) l'incrémente.
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.totalScore == resource.data.totalScore;

      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // declarations
    // ------------------------------------------------------------------
    match /declarations/{declarationId} {
      allow read: if isSignedIn();

      // Un joueur ne peut déclarer qu'en son propre nom, et uniquement à
      // l'état initial (ouvert, sans score).
      allow create: if isSignedIn()
        && hasProfile()
        && request.resource.data.declaredBy == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.scoreAwarded == null;

      // Pas de clôture ni de modification directe côté client : ça
      // passerait à côté du calcul de score. Seule la Cloud Function
      // closeDeclaration (Admin SDK) peut clôturer.
      allow update, delete: if false;

      // --------------------------------------------------------------
      // declarations/{id}/votes/{voterId}
      // --------------------------------------------------------------
      match /votes/{voterId} {
        allow read: if isSignedIn();

        // Un joueur ne peut écrire que son propre vote (id du doc = son
        // uid), pas sur sa propre déclaration, et uniquement tant qu'elle
        // est ouverte.
        allow create, update: if isSignedIn()
          && hasProfile()
          && request.auth.uid == voterId
          && declaration(declarationId).status == 'open'
          && declaration(declarationId).declaredBy != request.auth.uid;

        allow delete: if isSignedIn()
          && request.auth.uid == voterId
          && declaration(declarationId).status == 'open';
      }
    }
  }
}
